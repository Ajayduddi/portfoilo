{
    "name": "ajay-duddi-portfolio",
    "private": true,
    "version": "3.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc --project tsconfig.app.json && tsc --project tsconfig.node.json",
        "test": "node --experimental-strip-types --test --experimental-test-isolation=none tests/*.test.ts",
        "audit": "npm audit --audit-level=high",
        "audit:production": "npm audit --omit=dev --audit-level=high",
        "check": "npm run typecheck && npm test && npm run build"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "gsap": "^3.12.5",
        "solid-js": "^1.9.15",
        "tailwind-merge": "^3.7.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.19.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.2.2",
        "vite": "^8.3.3",
        "vite-plugin-solid": "^2.11.14"
    },
    "overrides": {
        "solid-js": {
            "seroval": "1.6.8",
            "seroval-plugins": "1.6.8"
        }
    }
}
